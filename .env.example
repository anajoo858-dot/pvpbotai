# Required: use a persistent PostgreSQL database (not ephemeral disk storage).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to require if your database provider requires TLS.
DATABASE_SSL=require
PORT=3000
NODE_ENV=development
# Generate a long random value; never commit the real secret.
SESSION_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this secret outside GitHub. Required for encrypted authentication vault storage.
VAULT_ENCRYPTION_KEY=
